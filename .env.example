# ==============================================================================
# .env.example — إدهام للوجستيات
# انسخ هذا الملف إلى .env ثم املأ القيم الحقيقية.
# تحذير: لا تضع أي أسرار حقيقية في هذا الملف — القيم هنا أمثلة/placeholders فقط.
# القيم الحقيقية توضع في .env المحلي (وهو مُتجاهَل من git).
# ==============================================================================

# --- البيئة العامة ---
NODE_ENV=development

# --- قاعدة البيانات (PostgreSQL) ---
# صيغة: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql://edham:edham_dev_pass@localhost:5432/edham_dev

# --- Redis (Cache + Bull Queues + JWT blacklist) ---
REDIS_URL=redis://localhost:6379

# --- المصادقة (JWT) ---
# ولّد مفاتيح عشوائية قوية عبر: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- المنافذ (Ports) — API على 3001، Web على 3000 ---
API_PORT=3001
WEB_PORT=3000

# --- تخزين الكائنات (MinIO / S3-compatible) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=edham
MINIO_SECRET_KEY=edham_dev_pass
MINIO_BUCKET=edham-uploads

# --- خرائط جوجل (Maps SDK + Directions + Distance Matrix) ---
GOOGLE_MAPS_API_KEY=

# --- Firebase (Admin SDK — Push Notifications) ---
# ضع ملف الخدمة في apps/api/firebase-service-account.json (مُتجاهَل)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=

# --- SMS (Unifonic) — mock في dev، unifonic في prod ---
SMS_PROVIDER=mock
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=Edham

# --- Email (Resend) — mock في dev، resend في prod ---
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=no-reply@edham.sa

# --- ZATCA (فوترة إلكترونية) — معطّل حتى onboarding العميل ---
ZATCA_ENABLED=false
ZATCA_VAT_NUMBER=
