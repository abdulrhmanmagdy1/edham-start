# apps/api/.env.example — قالب بيئة الإنتاج للـ Backend (انسخه إلى .env واملأ القيم)
NODE_ENV=production

# قاعدة البيانات + Redis (يوفّرهما المضيف — Railway/Render/…)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
REDIS_URL=redis://HOST:6379

# أسرار JWT — ولّد قيماً قوية عشوائية (openssl rand -hex 32) — لا تُعِد استخدام قيم dev
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32

# المنفذ (المضيف قد يحقنه عبر $PORT)
API_PORT=3001

# كلمة مرور حساب المشرف في الـ seed
SEED_SUPERVISOR_PASSWORD=CHANGE_ME

# Firebase Admin SDK — ضع مسار ملف الخدمة (سرّي، لا يُرفع في git)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=edham-logistics-501615
GOOGLE_MAPS_API_KEY=

# SMS: mock للتجربة | unifonic للإنتاج (يحتاج APP_SID صالح)
SMS_PROVIDER=mock
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=Edham

# Email: mock للتجربة | resend للإنتاج (يحتاج API key)
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=no-reply@edham.sa

# ZATCA — معطّل حتى onboarding الفعلي
ZATCA_ENABLED=false
ZATCA_VAT_NUMBER=
