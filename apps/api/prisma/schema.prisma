// ============================================================
// Prisma Schema — إدهام للوجستيات
// مرجع: docs/TECH.md §4 (Database Schema)
// قاعدة: لا تُعدَّل migration قديمة بعد merge. كل تغيير = migration جديد.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────  Enums (TECH.md §4.3)  ─────────────────────────────

enum UserRole {
  CUSTOMER
  DRIVER
  SUPERVISOR
  ACCOUNTANT
  WORKSHOP
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VehicleType {
  HIACE_VAN
  ISUZU_REFRIGERATED
  VOLVO_FH_HEAVY
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_MAINTENANCE
  OUT_OF_SERVICE
}

// نوعان فقط من التبريد (Q9)
enum TemperatureType {
  REFRIGERATED
  FROZEN
}

enum TemperatureCapability {
  REFRIGERATED
  FROZEN
  BOTH
}

enum CargoType {
  DRY
  CHILLED
  FROZEN
  HAZARDOUS
}

enum OrderStatus {
  DRAFT
  PENDING_PRICING
  PRICED
  CUSTOMER_CONFIRMED
  ASSIGNED
  LOADING
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum TripStatus {
  ASSIGNED
  IN_PROGRESS
  AT_STOP
  COMPLETED
  CANCELLED
}

enum TripStopStatus {
  PENDING
  ARRIVED
  DELIVERED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum MaintenanceType {
  ROUTINE
  EMERGENCY
  INSPECTION
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
}

enum NotificationType {
  ORDER_STATUS
  TRIP_ASSIGNED
  COLD_CHAIN_ALERT
  MAINTENANCE_REMINDER
  PAYMENT_DUE
  PRICE_SENT
  PRICE_ACCEPTED
  PRICE_REJECTED
  SYSTEM
}

// ─────────────────────────────  Models  ─────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @map("full_name") @db.VarChar(100)
  phone        String     @unique @db.VarChar(15)
  email        String?    @unique @db.VarChar(255)
  role         UserRole
  status       UserStatus @default(ACTIVE)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  otpCode      String?    @map("otp_code") @db.VarChar(6)
  otpExpiresAt DateTime?  @map("otp_expires_at") @db.Timestamptz(6)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  customer         Customer?
  driver           Driver?
  currentVehicles  Vehicle[]            @relation("VehicleCurrentDriver")
  notifications    Notification[]
  auditLogs        AuditLog[]
  reportedRequests MaintenanceRequest[] @relation("MaintenanceReportedBy")
  assignedRequests MaintenanceRequest[] @relation("MaintenanceAssignedTo")

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Customer {
  id                           String    @id @default(uuid()) @db.Uuid
  userId                       String    @unique @map("user_id") @db.Uuid
  companyName                  String    @map("company_name") @db.VarChar(255)
  commercialRegistrationNumber String?   @unique @map("commercial_registration_number") @db.VarChar(50)
  vatNumber                    String?   @map("vat_number") @db.VarChar(20)
  contactPersonName            String?   @map("contact_person_name") @db.VarChar(255)
  billingAddress               String?   @map("billing_address") @db.Text
  billingEmail                 String?   @map("billing_email") @db.VarChar(255)
  paymentTermsDays             Int       @default(30) @map("payment_terms_days")
  creditLimit                  Decimal?  @map("credit_limit") @db.Decimal(12, 2)
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User                    @relation(fields: [userId], references: [id])
  orders            Order[]
  invoices          Invoice[]
  pricingOverrides  ClientPricingOverride[]

  @@index([userId])
  @@index([vatNumber])
  @@map("customers")
}

model Driver {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @unique @map("user_id") @db.Uuid
  employeeId        String       @unique @map("employee_id") @db.VarChar(20)
  licenseNumber     String       @unique @map("license_number") @db.VarChar(20)
  licenseExpiry     DateTime     @map("license_expiry") @db.Date
  assignedVehicleId String?      @map("assigned_vehicle_id") @db.Uuid
  status            DriverStatus @default(AVAILABLE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User             @relation(fields: [userId], references: [id])
  assignedVehicle  Vehicle?         @relation("DriverAssignedVehicle", fields: [assignedVehicleId], references: [id])
  trips            Trip[]
  temperatureLogs  TemperatureLog[]

  @@index([status])
  @@index([licenseExpiry])
  @@map("drivers")
}

model Vehicle {
  id                    String                @id @default(uuid()) @db.Uuid
  plateNumber           String                @unique @map("plate_number") @db.VarChar(20)
  type                  VehicleType
  make                  String                @db.VarChar(50)
  model                 String                @db.VarChar(50)
  year                  Int                   @db.SmallInt
  capacityKg            Decimal               @map("capacity_kg") @db.Decimal(8, 2)
  temperatureCapability TemperatureCapability @map("temperature_capability")
  status                VehicleStatus         @default(AVAILABLE)
  currentDriverId       String?               @map("current_driver_id") @db.Uuid
  lastMaintenanceDate   DateTime?             @map("last_maintenance_date") @db.Date
  nextMaintenanceDate   DateTime?             @map("next_maintenance_date") @db.Date
  registrationExpiry    DateTime?             @map("registration_expiry") @db.Date
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?             @map("deleted_at") @db.Timestamptz(6)

  currentDriver       User?                @relation("VehicleCurrentDriver", fields: [currentDriverId], references: [id])
  assignedDrivers     Driver[]             @relation("DriverAssignedVehicle")
  trips               Trip[]
  locations           LocationPoint[]
  maintenanceRequests MaintenanceRequest[]

  @@index([status])
  @@index([type])
  @@index([temperatureCapability])
  @@index([nextMaintenanceDate])
  @@map("vehicles")
}

model Order {
  id                  String           @id @default(uuid()) @db.Uuid
  customerId          String           @map("customer_id") @db.Uuid
  pickupAddress       String           @map("pickup_address") @db.Text
  pickupLat           Decimal          @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng           Decimal          @map("pickup_lng") @db.Decimal(10, 7)
  deliveryAddress     String           @map("delivery_address") @db.Text
  deliveryLat         Decimal          @map("delivery_lat") @db.Decimal(10, 7)
  deliveryLng         Decimal          @map("delivery_lng") @db.Decimal(10, 7)
  cargoType           CargoType        @map("cargo_type")
  cargoWeightKg       Decimal          @map("cargo_weight_kg") @db.Decimal(8, 2)
  cargoDescription    String?          @map("cargo_description") @db.Text
  vehicleTypeRequired VehicleType      @map("vehicle_type_required")
  coldChainRequired   Boolean          @default(false) @map("cold_chain_required")
  temperatureType     TemperatureType? @map("temperature_type")
  tempMinCelsius      Decimal?         @map("temp_min_celsius") @db.Decimal(5, 2)
  tempMaxCelsius      Decimal?         @map("temp_max_celsius") @db.Decimal(5, 2)
  // السعر يدخله المشرف يدوياً — لا حساب تلقائي (PRE-001)
  quotedPrice         Decimal?         @map("quoted_price") @db.Decimal(10, 2)
  pricingNotes        String?          @map("pricing_notes") @db.Text
  pricingSentAt       DateTime?        @map("pricing_sent_at") @db.Timestamptz(6)
  currency            String           @default("SAR") @db.Char(3)
  status              OrderStatus      @default(DRAFT)
  cancellationReason  String?          @map("cancellation_reason") @db.Text
  scheduledAt         DateTime         @map("scheduled_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?        @map("deleted_at") @db.Timestamptz(6)

  customer Customer    @relation(fields: [customerId], references: [id])
  stops    OrderStop[]
  trip     Trip?
  invoice  Invoice?

  @@index([customerId])
  @@index([status])
  @@index([scheduledAt])
  @@index([status, createdAt(sort: Desc)])
  @@map("orders")
}

// محطات الطلب وقت الإنشاء (Multi-Stop — SPEC A29). تُنسخ إلى trip_stops عند الإسناد.
model OrderStop {
  id               String    @id @default(uuid()) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  sequenceNumber   Int       @map("sequence_number")
  address          String    @db.Text
  city             String?   @db.VarChar(100)
  latitude         Decimal?  @db.Decimal(10, 8)
  longitude        Decimal?  @db.Decimal(11, 8)
  contactName      String?   @map("contact_name") @db.VarChar(255)
  contactPhone     String?   @map("contact_phone") @db.VarChar(20)
  scheduledArrival DateTime? @map("scheduled_arrival") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, sequenceNumber])
  @@index([orderId])
  @@map("order_stops")
}

model Trip {
  id                  String     @id @default(uuid()) @db.Uuid
  orderId             String     @unique @map("order_id") @db.Uuid
  driverId            String     @map("driver_id") @db.Uuid
  vehicleId           String     @map("vehicle_id") @db.Uuid
  status              TripStatus
  estimatedDistanceKm Decimal?   @map("estimated_distance_km") @db.Decimal(8, 2)
  actualDistanceKm    Decimal?   @map("actual_distance_km") @db.Decimal(8, 2)
  actualStartAt       DateTime?  @map("actual_start_at") @db.Timestamptz(6)
  loadingStartAt      DateTime?  @map("loading_start_at") @db.Timestamptz(6)
  inTransitAt         DateTime?  @map("in_transit_at") @db.Timestamptz(6)
  deliveredAt         DateTime?  @map("delivered_at") @db.Timestamptz(6)
  actualEndAt         DateTime?  @map("actual_end_at") @db.Timestamptz(6)
  proofPhotos         Json?      @map("proof_photos")
  recipientName       String?    @map("recipient_name") @db.VarChar(100)
  recipientSignatureUrl String?  @map("recipient_signature_url") @db.Text
  totalStops          Int        @default(1) @map("total_stops")
  notes               String?    @db.Text
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  order           Order            @relation(fields: [orderId], references: [id])
  driver          Driver           @relation(fields: [driverId], references: [id])
  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id])
  stops           TripStop[]
  locations       LocationPoint[]
  temperatureLogs TemperatureLog[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@map("trips")
}

model TripStop {
  id               String         @id @default(uuid()) @db.Uuid
  tripId           String         @map("trip_id") @db.Uuid
  sequenceNumber   Int            @map("sequence_number")
  address          String         @db.Text
  city             String?        @db.VarChar(100)
  latitude         Decimal?       @db.Decimal(10, 8)
  longitude        Decimal?       @db.Decimal(11, 8)
  contactName      String?        @map("contact_name") @db.VarChar(255)
  contactPhone     String?        @map("contact_phone") @db.VarChar(20)
  scheduledArrival DateTime?      @map("scheduled_arrival") @db.Timestamptz(6)
  actualArrival    DateTime?      @map("actual_arrival") @db.Timestamptz(6)
  status           TripStopStatus @default(PENDING)
  podPhotoUrl      String?        @map("pod_photo_url") @db.Text
  podSignatureUrl  String?        @map("pod_signature_url") @db.Text
  notes            String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id])

  @@unique([tripId, sequenceNumber])
  @@index([tripId])
  @@index([tripId, status])
  @@map("trip_stops")
}

model LocationPoint {
  id              String    @id @default(uuid()) @db.Uuid
  vehicleId       String    @map("vehicle_id") @db.Uuid
  tripId          String?   @map("trip_id") @db.Uuid
  lat             Decimal   @db.Decimal(10, 7)
  lng             Decimal   @db.Decimal(10, 7)
  accuracyMeters  Decimal?  @map("accuracy_meters") @db.Decimal(6, 2)
  speedKmh        Decimal?  @map("speed_kmh") @db.Decimal(5, 2)
  bearingDegrees  Decimal?  @map("bearing_degrees") @db.Decimal(5, 2)
  isOfflineSynced Boolean   @default(false) @map("is_offline_synced")
  recordedAt      DateTime  @map("recorded_at") @db.Timestamptz(6)
  syncedAt        DateTime? @map("synced_at") @db.Timestamptz(6)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  trip    Trip?   @relation(fields: [tripId], references: [id])

  @@index([vehicleId, recordedAt(sort: Desc)])
  @@index([tripId])
  @@index([recordedAt(sort: Desc)])
  @@map("locations")
}

model TemperatureLog {
  id                 String    @id @default(uuid()) @db.Uuid
  tripId             String    @map("trip_id") @db.Uuid
  driverId           String    @map("driver_id") @db.Uuid
  temperatureCelsius Decimal   @map("temperature_celsius") @db.Decimal(5, 2)
  isViolation        Boolean   @default(false) @map("is_violation")
  notes              String?   @db.Text
  isOfflineSynced    Boolean   @default(false) @map("is_offline_synced")
  recordedAt         DateTime  @map("recorded_at") @db.Timestamptz(6)
  syncedAt           DateTime? @map("synced_at") @db.Timestamptz(6)

  trip   Trip   @relation(fields: [tripId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([tripId])
  @@index([recordedAt(sort: Desc)])
  @@map("temperature_logs")
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @unique @map("order_id") @db.Uuid
  customerId       String        @map("customer_id") @db.Uuid
  invoiceNumber    String        @unique @map("invoice_number") @db.VarChar(20)
  subtotal         Decimal       @db.Decimal(12, 2)
  vatRate          Decimal       @default(0.15) @map("vat_rate") @db.Decimal(5, 4)
  vatAmount        Decimal       @map("vat_amount") @db.Decimal(12, 2)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency         String        @default("SAR") @db.Char(3)
  status           InvoiceStatus @default(DRAFT)
  zatcaUuid        String?       @map("zatca_uuid") @db.VarChar(36)
  zatcaHash        String?       @map("zatca_hash") @db.Text
  zatcaQr          String?       @map("zatca_qr") @db.Text
  pdfUrl           String?       @map("pdf_url") @db.Text
  issuedAt         DateTime?     @map("issued_at") @db.Timestamptz(6)
  dueAt            DateTime?     @map("due_at") @db.Timestamptz(6)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  paymentReference String?       @map("payment_reference") @db.VarChar(100)
  notes            String?       @db.Text
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order    Order    @relation(fields: [orderId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([dueAt])
  @@map("invoices")
}

model PricingTier {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @unique @db.VarChar(100)
  basePricePerKm       Decimal? @map("base_price_per_km") @db.Decimal(10, 2)
  basePricePerKg       Decimal? @map("base_price_per_kg") @db.Decimal(10, 2)
  temperatureSurcharge Decimal? @map("temperature_surcharge") @db.Decimal(10, 2)
  minCharge            Decimal? @map("min_charge") @db.Decimal(10, 2)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  overrides ClientPricingOverride[]

  @@map("pricing_tiers")
}

model ClientPricingOverride {
  id                 String    @id @default(uuid()) @db.Uuid
  clientId           String    @map("client_id") @db.Uuid
  pricingTierId      String?   @map("pricing_tier_id") @db.Uuid
  customPricePerKm   Decimal?  @map("custom_price_per_km") @db.Decimal(10, 2)
  customPricePerKg   Decimal?  @map("custom_price_per_kg") @db.Decimal(10, 2)
  discountPercentage Decimal?  @map("discount_percentage") @db.Decimal(5, 2)
  validFrom          DateTime? @map("valid_from") @db.Date
  validUntil         DateTime? @map("valid_until") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client      Customer     @relation(fields: [clientId], references: [id])
  pricingTier PricingTier? @relation(fields: [pricingTierId], references: [id])

  @@index([clientId])
  @@index([clientId, validFrom, validUntil])
  @@map("client_pricing_overrides")
}

model MaintenanceRequest {
  id          String            @id @default(uuid()) @db.Uuid
  vehicleId   String            @map("vehicle_id") @db.Uuid
  type        MaintenanceType
  description String            @db.Text
  reportedBy  String            @map("reported_by") @db.Uuid
  assignedTo  String?           @map("assigned_to") @db.Uuid
  cost        Decimal?          @db.Decimal(10, 2)
  partsUsed   String?           @map("parts_used") @db.Text
  status      MaintenanceStatus @default(OPEN)
  scheduledAt DateTime?         @map("scheduled_at") @db.Timestamptz(6)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(6)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle        Vehicle @relation(fields: [vehicleId], references: [id])
  reportedByUser User    @relation("MaintenanceReportedBy", fields: [reportedBy], references: [id])
  assignedToUser User?   @relation("MaintenanceAssignedTo", fields: [assignedTo], references: [id])

  @@index([vehicleId])
  @@index([status])
  @@index([scheduledAt])
  @@map("maintenance_requests")
}

model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  type          NotificationType
  title         String           @db.VarChar(200)
  body          String           @db.Text
  isRead        Boolean          @default(false) @map("is_read")
  referenceType String?          @map("reference_type") @db.VarChar(50)
  referenceId   String?          @map("reference_id") @db.Uuid
  fcmMessageId  String?          @map("fcm_message_id") @db.VarChar(255)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  timestamp  DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp(sort: Desc)])
  @@map("audit_logs")
}
