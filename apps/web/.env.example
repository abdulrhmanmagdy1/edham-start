# apps/web/.env.example — قالب بيئة الإنتاج للـ Web (انسخه إلى .env.local أو اضبطه في Vercel)
# عنوان الـ API المرفوع (بدون / في النهاية)
NEXT_PUBLIC_API_URL=https://api.YOURDOMAIN.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.YOURDOMAIN.com

# مفتاح خرائط Google للمتصفح (اختياري — يوجد بديل إدخال يدوي)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
